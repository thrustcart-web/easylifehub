{
  "_comment": "كل إعدادات النظام في الملف ده. عدّل القيم اللي بينها [ ] بس. باقي الحقول متسيبها زي ما هي.",
  "blog": {
    "id": "6831073772272108266",
    "locale": "en-US",
    "url": "https://www.honesttrove.com",
    "name": "Honest Trove"
  },
  "schedule": {
    "daily_posts": 6,
    "max_queue_size": 60,
    "publish_hours_local": [
      9,
      11,
      13,
      15,
      17,
      19
    ],
    "jitter_minutes": 25,
    "timezone": "Africa/Cairo"
  },
  "ramp": {
    "_comment": "Immediate six-article generation target; staged ramp is disabled because the requested daily target is 6.",
    "enabled": false,
    "stages": [
      {
        "day": 0,
        "posts_per_day": 3
      },
      {
        "day": 10,
        "posts_per_day": 4
      },
      {
        "day": 30,
        "posts_per_day": 5
      },
      {
        "day": 60,
        "posts_per_day": 6
      }
    ]
  },
  "content": {
    "language": "en",
    "min_words": 501,
    "target_words": 700,
    "template_weights": {
      "review": 46,
      "bestof": 30,
      "comparison": 24
    },
    "ai_mode": "ai_first",
    "fallback_to_template": false,
    "label": "Reviews",
    "keyword_cooldown_days": 45
  },
  "affiliate": {
    "tag": "hotr0e-20",
    "marketplace": "com",
    "country": "US",
    "currency": "USD",
    "use_search_links_when_no_asin": false,
    "link_rel": "nofollow sponsored noopener",
    "disclosure": "Disclosure: This article contains affiliate links. We may earn a commission if you purchase through these links, at no additional cost to you.",
    "require_verified_product_pages": true
  },
  "images": {
    "provider": "unsplash",
    "access_key": "PUT_YOUR_UNSPLASH_ACCESS_KEY_HERE_OPTIONAL",
    "fallback_svg": true,
    "cache_file": ".cache/images.json",
    "attribution": true
  },
  "ai": {
    "primary": "groq",
    "fallbacks": [
      "openrouter",
      "gemini"
    ],
    "temperature": 0.85,
    "max_output_tokens": 6000,
    "retries": 2,
    "providers": {
      "groq": {
        "env_key": "GROQ_API_KEY",
        "model": "openai/gpt-oss-120b",
        "fallback_models": [
          "qwen/qwen3.8-27b",
          "openai/gpt-oss-20b"
        ],
        "base_url": "https://api.groq.com/openai/v1"
      },
      "openrouter": {
        "env_key": "OPENROUTER_API_KEY",
        "model": "openrouter/free",
        "base_url": "https://openrouter.ai/api/v1"
      },
      "gemini": {
        "env_key": "GEMINI_API_KEY",
        "model": "gemini-3.6-flash",
        "base_url": "https://generativelanguage.googleapis.com/v1beta",
        "fallback_models": [
          "gemini-3.5-flash-lite",
          "gemini-3.1-flash-lite"
        ]
      }
    }
  },
  "github": {
    "repo_raw_base": "https://raw.githubusercontent.com/thrustcart-web/easylifehub/main"
  },
  "notify": {
    "email": "thrustcart@gmail.com",
    "only_on_failure": true
  },
  "safety": {
    "max_consecutive_failures": 3,
    "cooldown_hours": 24,
    "min_seconds_between_posts": 7200,
    "max_posts_per_day_hard_cap": 6
  },
  "categories": {
    "_comment": "Category hub page generation and publishing are disabled.",
    "enabled": false,
    "hub_path": "content/categories/index.html",
    "page_title": "Browse All Categories",
    "related_limit": 4,
    "show_chips_in_posts": false
  },
  "product_discovery": {
    "provider": "apify",
    "amazon_domain": "amazon.com",
    "require_exact_title_tokens": true,
    "cache_file": ".cache/amazon_asins.json",
    "actor": "junglee/amazon-crawler",
    "api_env": "TEST_API",
    "max_results_per_search": 3,
    "search_pages": 1,
    "scrape_product_details": false,
    "available_providers": [
      "apify"
    ],
    "provider_selection_variable": "PRODUCT_DISCOVERY_PROVIDER",
    "fallback_note": "Apify is the only configured product source. It reads Amazon product details and explicit in-stock status. Paid lookups require both per-run approval and APIFY_SPEND_ENABLED=true. Amazon Creators API and SerpApi are not used by the active pipeline.",
    "fallback_providers": []
  }
}
